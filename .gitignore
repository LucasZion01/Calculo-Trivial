# ============================================================
# Cálculo Trivial
# Flutter / Dart / Android / iOS
# Security-conscious Git ignore rules
# ============================================================


# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------

*.class
*.log
*.pyc
*.swp

.DS_Store
Thumbs.db

.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/


# ------------------------------------------------------------
# IntelliJ / Android Studio
# ------------------------------------------------------------

*.iml
*.ipr
*.iws

.idea/


# ------------------------------------------------------------
# VS Code
# ------------------------------------------------------------

# Mantido fora do Git para evitar configurações locais.
.vscode/


# ------------------------------------------------------------
# Flutter / Dart / Pub
# ------------------------------------------------------------

**/doc/api/
**/ios/Flutter/.last_build_id

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

.pub-cache/
.pub/

build/
coverage/

.packages


# ------------------------------------------------------------
# Flutter generated / ephemeral files
# ------------------------------------------------------------

**/flutter/ephemeral/
**/Flutter/ephemeral/

**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake

ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh


# ------------------------------------------------------------
# Android local / generated files
# ------------------------------------------------------------

android/.gradle/
android/.kotlin/

android/local.properties

android/app/debug/
android/app/profile/
android/app/release/

*.apk
*.aab


# ------------------------------------------------------------
# Android signing / release credentials
# NEVER commit these files
# ------------------------------------------------------------

*.jks
*.keystore

key.properties
android/key.properties

*.p12
*.pfx
*.pem
*.key

upload-keystore.*
release-keystore.*
debug-keystore.*


# ------------------------------------------------------------
# Environment variables / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.env

secrets/
secret/
credentials/
credentials.json

*.secrets.json
*.credentials.json


# ------------------------------------------------------------
# Service accounts / private credentials
# ------------------------------------------------------------

*service-account*.json
*service_account*.json

serviceAccountKey.json
service-account.json

firebase-adminsdk-*.json

*-private-key.json
*private_key*.json


# ------------------------------------------------------------
# Firebase client configuration
# ------------------------------------------------------------

# firebase_options.dart, google-services.json and
# GoogleService-Info.plist are client configuration files required
# to build the public project. They are intentionally versioned.
# Access control must be enforced by Firebase Security Rules,
# App Check and restricted Firebase API keys.


# ------------------------------------------------------------
# Firebase App Check / debug tokens
# ------------------------------------------------------------

appcheck-debug-token*
app_check_debug_token*

firebase-debug.log
firebase-debug.*


# ------------------------------------------------------------
# RevenueCat
# ------------------------------------------------------------

revenuecat.env
revenuecat.json
revenuecat.config.json

*revenuecat-secret*
*revenuecat_private*

purchases.env


# ------------------------------------------------------------
# Apple certificates / provisioning profiles
# ------------------------------------------------------------

*.mobileprovision
*.cer
*.p8


# ------------------------------------------------------------
# Symbolication / obfuscation
# ------------------------------------------------------------

app.*.symbols
app.*.map.json


# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.orig

~$*
.firebase/
