{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "calculo-trivial-app-646bb",
          "appId": "1:617140538662:android:665a235fb59046509245e7",
          "fileOutput": "android/app/google-services.json"
        }
      }
    },
    "dart": {
      "lib/firebase_options.dart": {
        "projectId": "calculo-trivial-app-646bb",
        "configurations": {
          "android": "1:617140538662:android:665a235fb59046509245e7",
          "ios": "1:617140538662:ios:621fffcd244698be9245e7",
          "macos": "1:617140538662:ios:621fffcd244698be9245e7",
          "web": "1:617140538662:web:206f4513983c65079245e7",
          "windows": "1:617140538662:web:09d0c2c0fa5003a09245e7"
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
