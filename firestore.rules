rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function validLessonIds(values) {
      return values is list
        && values.size() <= 6
        && values.hasOnly([
          'algebra-fundamental',
          'equacoes-inequacoes',
          'funcoes',
          'limites',
          'continuidade',
          'derivadas'
        ]);
    }

    function validQuestionSessions(values) {
      return values is map
        && values.keys().hasOnly([
          'algebra-fundamental',
          'equacoes-inequacoes',
          'funcoes',
          'limites',
          'continuidade',
          'derivadas'
        ]);
    }

    function validContentLessonIds(values) {
      return values is list
        && values.size() <= 31
        && values.hasOnly([
          'algebra-01-linguagem',
          'algebra-02-termos-semelhantes',
          'algebra-03-distributiva',
          'algebra-04-potencias',
          'algebra-05-produtos-notaveis',
          'algebra-06-fatoracao',
          'algebra-07-fracoes-algebricas',
          'algebra-08-sintese',
          'limites-01-intuicao',
          'limites-02-laterais',
          'limites-03-propriedades',
          'limites-04-fatoracao',
          'limites-05-racionalizacao',
          'limites-06-infinito',
          'limites-07-trigonometricos',
          'limites-08-sintese',
          'continuidade-01-significado',
          'continuidade-02-dominio',
          'continuidade-03-descontinuidades',
          'continuidade-04-partes',
          'continuidade-05-parametros',
          'continuidade-06-valor-intermediario',
          'continuidade-07-sintese',
          'derivadas-01-significado',
          'derivadas-02-regras-basicas',
          'derivadas-03-produto-quociente',
          'derivadas-04-cadeia',
          'derivadas-05-elementares',
          'derivadas-06-tangente',
          'derivadas-07-derivabilidade',
          'derivadas-08-aplicacoes'
        ]);
    }

    function validDateKey(value) {
      return value == null
        || (
          value is string
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
    }

    function validProgress() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'completedLessonIds',
          'completedContentLessonIds',
          'algebraFundamentalCompleted',
          'equationsAndInequationsCompleted',
          'functionsCompleted',
          'limitsCompleted',
          'continuityCompleted',
          'derivativesCompleted',
          'totalXp',
          'totalGold',
          'totalAnswerAttempts',
          'correctAnswerAttempts',
          'incorrectAnswerAttempts',
          'accuracy',
          'studyStreak',
          'lastStudyDate',
          'dailyAnsweredQuestions',
          'dailyQuestionGoal',
          'dailyActivityDate',
          'lastQuestionSessionIds',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'completedLessonIds',
          'completedContentLessonIds',
          'algebraFundamentalCompleted',
          'equationsAndInequationsCompleted',
          'functionsCompleted',
          'limitsCompleted',
          'continuityCompleted',
          'derivativesCompleted',
          'totalXp',
          'totalGold',
          'totalAnswerAttempts',
          'correctAnswerAttempts',
          'incorrectAnswerAttempts',
          'accuracy',
          'studyStreak',
          'dailyAnsweredQuestions',
          'dailyQuestionGoal',
          'lastQuestionSessionIds',
          'updatedAt'
        ])
        && validLessonIds(data.completedLessonIds)
        && validContentLessonIds(data.completedContentLessonIds)
        && data.algebraFundamentalCompleted is bool
        && data.equationsAndInequationsCompleted is bool
        && data.functionsCompleted is bool
        && data.limitsCompleted is bool
        && data.continuityCompleted is bool
        && data.derivativesCompleted is bool
        && data.totalXp is int
        && data.totalXp >= 0
        && data.totalXp <= 510
        && data.totalGold is int
        && data.totalGold >= 0
        && data.totalGold <= 225
        && data.totalAnswerAttempts is int
        && data.totalAnswerAttempts >= 0
        && data.correctAnswerAttempts is int
        && data.correctAnswerAttempts >= 0
        && data.correctAnswerAttempts <= data.totalAnswerAttempts
        && data.incorrectAnswerAttempts is int
        && data.incorrectAnswerAttempts
          == data.totalAnswerAttempts - data.correctAnswerAttempts
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 1
        && data.studyStreak is int
        && data.studyStreak >= 0
        && data.dailyAnsweredQuestions is int
        && data.dailyAnsweredQuestions >= 0
        && data.dailyQuestionGoal == 5
        && validDateKey(data.lastStudyDate)
        && validDateKey(data.dailyActivityDate)
        && validQuestionSessions(data.lastQuestionSessionIds)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read, delete:
        if isOwner(userId);

      match /progress/current {
        allow read, delete:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && validProgress();
      }
    }
  }
}
